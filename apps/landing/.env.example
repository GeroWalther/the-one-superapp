# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas or self-hosted.
# Example: mongodb+srv://user:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=theone

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Signs web session cookies and mobile JWTs. Generate: openssl rand -base64 32
SESSION_SECRET=

# Keys the blocklist and activation/reset token hashes.
# Falls back to SESSION_SECRET when unset.
# ⚠ Rotating this invalidates the blocklist and all outstanding tokens — pin it
#   separately so SESSION_SECRET stays rotatable.
HASH_SECRET=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Without both of these, emails are logged to the server console instead of sent.
RESEND_API_KEY=
MAIL_FROM="TheONE <noreply@your-verified-domain.com>"

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── AI assistant ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Partner image uploads (Vercel Blob) ─────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─── Admin bootstrap ─────────────────────────────────────────────────────────
# Comma-separated addresses allowed to be seeded as administrators by
# `pnpm admin:create`. Not a login mechanism on its own.
ADMIN_EMAILS=

# ─── Public URL ──────────────────────────────────────────────────────────────
# Used to build activation, invitation, and password-reset links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:5656

# --- AI assistant model (optional) ------------------------------------------
# Defaults to claude-haiku-4-5. Set claude-opus-5 for better advice at higher cost.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Pre-launch test mode ---------------------------------------------------
# Lets an approved account go live without paying, so the enrol -> approve ->
# activate -> live loop is walkable before Stripe exists. Ignored outright once
# STRIPE_SECRET_KEY is set, so leaving it on at launch cannot hand out free
# accounts. Seed test users with: node --env-file=.env.local scripts/seed-test-users.mjs
ALLOW_TEST_ACTIVATION=1
