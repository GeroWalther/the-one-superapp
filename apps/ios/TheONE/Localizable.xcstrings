    "The best brokers in the world with their exceptional estates, and your own property sold with them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die besten Makler der Welt mit ihren außergewöhnlichen Anwesen. Und deine Immobilie verkaufst du mit ihnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les meilleurs agents immobiliers du monde avec leurs propriétés d'exception, et ton propre bien vendu avec eux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I migliori agenti immobiliari del mondo con le loro proprietà eccezionali, e il tuo immobile venduto con loro."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفضل الوسطاء العقاريين في العالم بعقاراتهم الاستثنائية، وعقارك أنت يُباع معهم."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全球最好的房产经纪人和他们的非凡房产，你自己的房产也可以由他们出售。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mejores agentes inmobiliarios del mundo con sus propiedades excepcionales, y tu propia propiedad vendida con ellos."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najbolji agenti za nekretnine na svijetu sa svojim iznimnim nekretninama, i tvoja vlastita nekretnina prodana s njima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучшие брокеры мира с их исключительной недвижимостью, и твоя собственная недвижимость, проданная вместе с ними."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünyanın en iyi emlak danışmanları olağanüstü mülkleriyle, ve kendi mülkün onlarla satılır."
          }
        }
      }
    },
    "The brokers also send you properties that are never publicly listed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Makler schicken dir auch Immobilien, die nie öffentlich inseriert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents t'envoient aussi des biens qui ne sont jamais publiés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli agenti ti inviano anche immobili mai pubblicati."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل لك الوسطاء أيضًا عقارات لا تُعرض علنًا أبدًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经纪人也会为你推荐从不公开挂牌的房产。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes también te envían propiedades que nunca se publican."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenti ti šalju i nekretnine koje nikada nisu javno oglašene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Брокеры присылают тебе и объекты, которые никогда не публикуются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Danışmanlar sana hiç ilana çıkmayan mülkleri de gönderir."
          }
        }
      }
    },
    "The finest hotels and resorts, chosen for you.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die schönsten Hotels und Resorts, für dich ausgewählt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plus beaux hôtels et resorts, choisis pour toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli hotel e i resort più belli, scelti per te."
          }
        },
        "ar": {
