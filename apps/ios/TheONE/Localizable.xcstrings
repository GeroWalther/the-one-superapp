    "Your access is approved but not yet paid for. Finish checkout on theone-superapp.com to sign in.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Zugang ist freigegeben, aber noch nicht bezahlt. Schließe die Bezahlung auf theone-superapp.com ab, um dich anzumelden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
