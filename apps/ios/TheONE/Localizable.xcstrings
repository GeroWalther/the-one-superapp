    "While paused, nobody is shown your profile. Your details are kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert wird dein Profil niemandem vorgeschlagen. Deine Angaben bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant la pause, ton profil n'est montré à personne. Tes informations sont conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la pausa il tuo profilo non viene mostrato a nessuno. I tuoi dati restano salvati."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء الإيقاف المؤقت، لا يُعرض ملفك الشخصي على أحد. وتبقى بياناتك محفوظة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停期间，任何人都看不到你的资料。你的信息会被保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras está en pausa, nadie ve tu perfil. Tus datos se conservan."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dok je profil pauziran, nitko ga ne vidi. Tvoji podaci ostaju sačuvani."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока профиль на паузе, его никому не показывают. Твои данные сохраняются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatıldığında profilin kimseye gösterilmez. Bilgilerin saklanır."
          }
        }
      }
    },
