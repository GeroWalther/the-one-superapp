    "You will be connected with the one and only person who is your MATCH.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst mit dem einen einzigen Menschen verbunden, der dein MATCH ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous te présenterons la seule et unique personne qui est ton MATCH."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti metteremo in contatto con l'unica persona che è il tuo MATCH."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنعرّفك على شخص واحد فقط، هو MATCH الخاص بك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们只会为你引荐那位独一无二、真正属于你的 MATCH。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te presentaremos a la única persona que es tu MATCH."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezat ćemo te s jednom jedinom osobom koja je tvoj MATCH."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы познакомим тебя с единственным человеком, который и есть твой MATCH."
          }
        },
