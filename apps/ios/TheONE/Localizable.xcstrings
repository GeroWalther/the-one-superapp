    "Once you both say yes, you will find each other here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald ihr beide Ja sagt, findest du dein Gegenüber hier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès que vous aurez dit oui des deux côtés, vous vous retrouverez ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando entrambi direte sì, vi troverete qui."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بمجرد أن يوافق كلاكما، سيظهر التعارف هنا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
