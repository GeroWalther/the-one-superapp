    "Once you both say yes, you will find each other here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald ihr beide Ja sagt, findest du dein Gegenüber hier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès que vous aurez dit oui des deux côtés, vous vous retrouverez ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando entrambi direte sì, vi troverete qui."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بمجرد أن يوافق كلاكما، سيظهر التعارف هنا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你们都说愿意，就会在这里找到彼此。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el sí sea mutuo, encontrarás aquí tu conexión."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad oboje kažete da, ovdje ćete se pronaći."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как только вы оба скажете «да», вы найдёте друг друга здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkiniz de evet dediğinizde birbirinizi burada bulacaksınız."
          }
        }
      }
    },
    "Only live accounts can use the app.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App steht nur aktiven Konten offen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les comptes actifs peuvent utiliser l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo gli account attivi possono usare l'app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيق متاح للحسابات المفعّلة فقط."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅已激活的账户可使用此 App。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las cuentas activas pueden usar la app."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikaciju mogu koristiti samo aktivni računi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение доступно только для активных аккаунтов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı yalnızca aktif hesaplar kullanabilir."
          }
        }
      }
    },
    "Only someone who fits you completely ever sees your profile. Nobody browses faces.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Profil sieht nur, wer vollkommen zu dir passt. Niemand blättert durch Gesichter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule une personne qui te correspond parfaitement voit ton profil. Personne ne fait défiler des visages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo profilo lo vede solo chi è in perfetta sintonia con te. Nessuno sfoglia volti."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يرى ملفك الشخصي إلا من يتوافق معك تماماً. لا أحد يتصفح الوجوه."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有与你完全契合的人才能看到你的资料。这里没有人翻看一张张面孔。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo alguien que encaje contigo por completo verá tu perfil. Aquí nadie hojea rostros."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj profil vidi samo osoba koja ti u potpunosti odgovara. Nitko ne pregledava lica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой профиль видит только тот, кто подходит тебе полностью. Никто не листает лица."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilini yalnızca sana tamamen uyan biri görür. Kimse yüzler arasında gezinmez."
          }
        }
      }
    },
