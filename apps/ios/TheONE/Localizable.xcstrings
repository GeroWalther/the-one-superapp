    "I am not feeling so good right now. Can you help me?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir geht es gerade nicht so gut. Kannst du mir helfen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne me sens pas très bien en ce moment. Peux-tu m'aider ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo momento non sto molto bene. Mi puoi aiutare?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أشعر أنني بخير الآن. هل يمكنك مساعدتي؟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我现在感觉不太好。你能帮帮我吗？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no me siento muy bien. ¿Me puedes ayudar?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutačno mi nije baš dobro. Možeš li mi pomoći?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мне сейчас не очень хорошо. Можешь помочь?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an kendimi pek iyi hissetmiyorum. Bana yardım edebilir misin?"
          }
        }
      }
    },
    "I can't help with that one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dabei kann ich dir leider nicht helfen."
