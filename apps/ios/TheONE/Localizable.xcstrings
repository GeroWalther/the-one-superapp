    "I have just done my TheONE LONGEVITY CHECK. What do you recommend for me?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe gerade meinen TheONE LONGEVITY CHECK gemacht. Was empfiehlst du mir?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je viens de faire mon TheONE LONGEVITY CHECK. Que me recommandes-tu ?"
