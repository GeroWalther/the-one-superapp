    "Your face could not be seen clearly. Please try again in good light, facing the camera.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gesicht war nicht deutlich zu erkennen. Bitte versuche es noch einmal bei gutem Licht und schau dabei in die Kamera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton visage n'était pas assez visible. Réessaie avec une bonne lumière, face à l'appareil photo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo viso non si vedeva bene. Riprova con una buona luce, guardando verso la fotocamera."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يظهر وجهك بوضوح. يُرجى المحاولة مرة أخرى في إضاءة جيدة، مع النظر مباشرة إلى الكاميرا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能清晰识别你的面部。请在光线充足的地方正对镜头再试一次。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se veía bien tu cara. Inténtalo otra vez con buena luz, mirando a la cámara."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lice se nije jasno vidjelo. Pokušaj opet uz dobro svjetlo, gledajući u kameru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лицо было видно нечётко. Попробуй ещё раз при хорошем освещении, глядя в камеру."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzün net görünmüyordu. Lütfen iyi bir ışıkta, yüzün kameraya dönük şekilde tekrar dene."
          }
        }
      }
    },
