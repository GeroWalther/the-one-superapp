    "Pick at least one. The assistant uses these to decide what to suggest.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle mindestens eins. Danach richtet der Assistent seine Vorschläge aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis-en au moins un. L'assistant s'en sert pour savoir quoi te proposer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegline almeno uno. L'assistente se ne serve per capire cosa suggerirti."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرجى اختيار واحد على الأقل، فالمساعد يعتمد عليها ليقرر ما يقترحه عليك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少选择一项。助手会据此为你提供建议。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige al menos uno. El asistente lo tiene en cuenta para saber qué sugerirte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi barem jedno. Prema tome asistent odlučuje što će ti predložiti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери хотя бы один пункт. По ним ассистент решает, что тебе предложить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az birini seç. Asistan önerilerini bunlara göre belirler."
          }
        }
      }
    },
