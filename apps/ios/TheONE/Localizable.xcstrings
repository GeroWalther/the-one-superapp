        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditions, préférences, contraintes : l'assistant en tient compte avant de te conseiller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condizioni, preferenze, vincoli: l'assistente li legge prima di consigliarti."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالات صحية، تفضيلات، قيود: يقرأ المساعد هذا قبل أن يقدّم لك أي نصيحة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康状况、偏好、限制：助手在为你提供建议前会先阅读这些内容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Condiciones, preferencias, limitaciones: el asistente lo lee antes de aconsejarte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdravstvena stanja, želje, ograničenja: asistent to pročita prije nego što te savjetuje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние здоровья, предпочтения, ограничения: ассистент читает это, прежде чем дать тебе совет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahatsızlıklar, tercihler, kısıtlamalar: Asistan sana öneride bulunmadan önce bunları okur."
          }
        }
      }
    },
    "Contact opens only when you both say yes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontakt entsteht erst, wenn ihr beide Ja sagt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contact ne s'ouvre que lorsque vous dites oui, des deux côtés."
