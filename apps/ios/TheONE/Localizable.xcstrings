          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo accesso è approvato ma non ancora pagato. Completa il pagamento su theone-superapp.com per accedere."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت الموافقة على انضمامك، لكن الدفع لم يكتمل بعد. لتسجيل الدخول، يُرجى إتمام الدفع على theone-superapp.com."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的申请已获批准，但尚未付款。请在 theone-superapp.com 完成付款后登录。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu acceso está aprobado, pero el pago aún está pendiente. Completa el pago en theone-superapp.com para iniciar sesión."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj pristup je odobren, ali još nije plaćen. Dovrši plaćanje na theone-superapp.com za prijavu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой доступ одобрен, но ещё не оплачен. Заверши оплату на theone-superapp.com, чтобы войти."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişimin onaylandı, ancak ödemesi henüz yapılmadı. Giriş yapmak için ödemeyi theone-superapp.com üzerinden tamamla."
