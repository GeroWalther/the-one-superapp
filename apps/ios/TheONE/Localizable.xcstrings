    "We are looking for you.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir suchen für dich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous cherchons pour toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
