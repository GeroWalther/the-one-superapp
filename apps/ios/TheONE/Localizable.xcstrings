    "Good afternoon, %@. How are you today?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guten Tag, %@. Wie geht es dir heute?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon après-midi, %@. Comment vas-tu aujourd'hui ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Buon pomeriggio, %@. Come stai oggi?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طاب نهارك يا %@. كيف حالك اليوم؟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下午好，%@。今天还好吗？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buenas tardes, %@. ¿Cómo estás hoy?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobar dan, %@. Kako si danas?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добрый день, %@. Как ты сегодня?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İyi günler, %@. Bugün nasılsın?"
          }
        }
      }
    },
