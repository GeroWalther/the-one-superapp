        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho appena fatto il mio TheONE LONGEVITY CHECK. Cosa mi consigli?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجريت للتو TheONE LONGEVITY CHECK. بماذا تنصحني؟"
