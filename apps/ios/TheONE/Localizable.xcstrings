            "value": "Écris à un partenaire depuis sa page, ou laisse l'assistant vous mettre en relation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi a un partner aziendale dalla sua pagina, oppure lascia che sia l'assistente a metterti in contatto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك مراسلة أي شريك أعمال من صفحته، أو ترك المساعد يتولى التواصل بينكما."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
