    "Face the camera in soft daylight, without make-up if you can, hair away from your face.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau bei sanftem Tageslicht in die Kamera, möglichst ungeschminkt und mit den Haaren aus dem Gesicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place-toi face à l'objectif, à la douce lumière du jour, sans maquillage si possible, les cheveux dégagés du visage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda la fotocamera alla luce morbida del giorno, possibilmente senza trucco e con i capelli lontani dal viso."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرجى النظر إلى الكاميرا في ضوء نهار ناعم، ويُفضَّل دون مكياج، مع إبعاد الشعر عن الوجه."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在柔和的自然光下正对镜头，尽量不化妆，并将头发从脸上拨开。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira a la cámara con luz natural suave, sin maquillaje si puedes y con el pelo apartado de la cara."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gledaj u kameru pri blagom dnevnom svjetlu, po mogućnosti bez šminke, s kosom podalje od lica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотри в камеру при мягком дневном свете, по возможности без макияжа, убрав волосы с лица."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumuşak gün ışığında kameraya bak, mümkünse makyajsız ol ve saçlarını yüzünden uzak tut."
          }
        }
      }
    },
