        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con eso no puedo ayudarte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "S time ti ne mogu pomoći."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С этим я, к сожалению, помочь не могу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu konuda sana yardımcı olamıyorum."
          }
        }
