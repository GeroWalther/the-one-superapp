        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل ننظر إلى بشرتك معًا؟ سأخبرك بالضبط بما تحتاجه."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们一起看看你的皮肤好吗？我会准确告诉你它需要什么。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Miramos juntos tu piel? Te diré exactamente lo que necesita."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoćemo li zajedno pogledati tvoju kožu? Reći ću ti točno što joj treba."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрим на твою кожу вместе? Я скажу тебе точно, что ей нужно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cildine birlikte bakalım mı? Tam olarak neye ihtiyacı olduğunu sana söyleyeceğim."
          }
        }
      }
    },
