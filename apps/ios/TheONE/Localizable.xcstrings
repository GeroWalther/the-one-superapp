    "A precise reading of seven skin qualities, your personal routine and the business partners who can help.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine präzise Analyse von sieben Hautqualitäten, deine persönliche Routine und die Geschäftspartner, die dir helfen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une lecture précise de sept qualités de peau, ta routine personnelle et les partenaires qui peuvent t'aider."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lettura precisa di sette qualità della pelle, la tua routine personale e i partner aziendali che possono aiutarti."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة دقيقة لسبع خصائص في بشرتك، وروتين شخصي لك، وشركاء الأعمال القادرون على مساعدتك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精准解读七项肌肤指标，为你定制专属护理流程，并推荐能帮助你的合作伙伴。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lectura precisa de siete cualidades de la piel, tu rutina personal y los socios que pueden ayudarte."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Precizna procjena sedam svojstava kože, tvoja osobna rutina i poslovni partneri koji ti mogu pomoći."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точная оценка семи показателей кожи, твой личный уход и партнёры, которые могут помочь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedi cilt özelliğinin hassas bir değerlendirmesi, sana özel bakım rutinin ve sana yardımcı olabilecek iş ortakları."
          }
        }
      }
    },
