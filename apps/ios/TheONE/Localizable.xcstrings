    "If you like, you can keep your photos on this iPhone for a before and after.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du möchtest, kannst du deine Fotos für einen Vorher-Nachher-Vergleich auf diesem iPhone behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu le souhaites, tu peux garder tes photos sur cet iPhone pour comparer avant et après."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vuoi, puoi conservare le tue foto su questo iPhone per un confronto prima e dopo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن رغبت، يمكنك الاحتفاظ بصورك على جهاز iPhone هذا للمقارنة بين قبل وبعد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你愿意，可以将照片保存在这部 iPhone 上，用于前后对比。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si quieres, puedes guardar tus fotos en este iPhone para comparar el antes y el después."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako želiš, fotografije možeš sačuvati na ovom iPhoneu za usporedbu prije i poslije."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если хочешь, можно сохранить фото на этом iPhone, чтобы сравнить «до» и «после»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstersen önce ve sonra karşılaştırması için fotoğraflarını bu iPhone'da saklayabilirsin."
          }
        }
      }
    },
