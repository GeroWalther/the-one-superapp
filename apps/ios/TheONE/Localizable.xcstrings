    "Shall we find the one person who truly fits you, one hundred percent, both ways?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollen wir den einen Menschen finden, der wirklich zu dir passt, zu 100 % in beide Richtungen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et si nous trouvions la personne qui te correspond vraiment, à 100 %, dans les deux sens ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troviamo l'unica persona che ti corrisponde davvero, al 100 %, in entrambe le direzioni?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل نجد الشخص الوحيد الذي يناسبك حقًا، بنسبة 100 % ومن الطرفين؟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们一起找到那个真正适合你的人好吗？双向百分之百契合。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Encontramos a la única persona que de verdad encaja contigo, al 100 %, en ambos sentidos?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoćemo li pronaći jedinu osobu koja ti stvarno odgovara, 100 %, u oba smjera?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдём того единственного человека, который действительно тебе подходит, на 100 %, взаимно?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana gerçekten uyan o tek kişiyi, iki yönlü %100 uyumla bulalım mı?"
          }
        }
      }
    },
    "Shall we look at your skin together? I will tell you exactly what it needs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
