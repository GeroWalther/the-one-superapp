    "Nobody fits you in every way just now. As soon as someone meets every wish of yours, we will connect you.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Moment passt niemand in allem zu dir. Sobald es jemanden gibt, der jeden deiner Wünsche erfüllt, verbinden wir dich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l'instant, personne ne te correspond en tous points. Dès qu'une personne répondra à chacun de tes souhaits, nous vous présenterons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento nessuno è in sintonia con te sotto ogni aspetto. Appena qualcuno soddisferà ogni tuo desiderio, ti metteremo in contatto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد حالياً من يتوافق معك من كل النواحي. وبمجرد أن يلبّي أحدهم كل أمنياتك، سنجمع بينكما."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前还没有人与你处处契合。一旦有人符合你的每个心愿，我们就会为你引荐。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora, nadie encaja contigo en todo. En cuanto alguien cumpla cada uno de tus deseos, te pondremos en contacto."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutačno ti nitko ne odgovara u svemu. Čim netko ispuni svaku tvoju želju, povezat ćemo vas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока никто не подходит тебе во всём. Как только появится человек, отвечающий всем твоим желаниям, мы вас познакомим."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda sana her yönüyle uyan kimse yok. Her isteğini karşılayan biri çıktığı anda sizi tanıştıracağız."
          }
        }
      }
    },
    "Not a member yet?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Mitglied?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
