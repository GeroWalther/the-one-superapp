    "Stay healthy: prevention, health and wellness clinics, chosen for you.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesund bleiben: Prävention, Gesundheits- und Wellnesskliniken, für dich ausgewählt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rester en bonne santé : prévention, cliniques de santé et de bien-être, choisies pour toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restare in salute: prevenzione, cliniche della salute e del benessere, scelte per te."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على صحتك: الوقاية وعيادات الصحة والعافية، مختارة لك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持健康：预防、健康与养生诊所，为你精选。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenerse sano: prevención, clínicas de salud y bienestar, elegidas para ti."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostani zdrav: prevencija, klinike za zdravlje i wellness, odabrane za tebe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставаться здоровым: профилактика, клиники здоровья и велнеса, выбранные для тебя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlıklı kal: önleme, sağlık ve wellness klinikleri, senin için seçildi."
          }
        }
      }
    },
    "Stay young for longer: the best longevity clinics in your city, with check-ups and programmes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Länger jung bleiben: die besten Longevity-Kliniken deiner Stadt, mit Check-ups und Programmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rester jeune plus longtemps : les meilleures cliniques de longévité de ta ville, avec bilans et programmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restare giovani più a lungo: le migliori cliniche della longevità della tua città, con check-up e programmi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابقَ شابًا لفترة أطول: أفضل عيادات طول العمر في مدينتك، مع فحوصات وبرامج."
          }
        },
        "zh-Hans": {
          "stringUnit": {
