          }
        }
      }
    },
    "Each of them has your property in a chat of their own and will reply to you there with a first assessment and a date for a viewing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder von ihnen hat deine Immobilie in einem eigenen Chat und antwortet dir dort mit einer ersten Einschätzung und einem Termin für eine Besichtigung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacun d'eux a ton bien dans sa propre conversation et te répondra là avec une première estimation et une date de visite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ognuno di loro ha il tuo immobile in una chat dedicata e ti risponderà lì con una prima valutazione e una data per la visita."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لدى كل واحد منهم عقارك في محادثة خاصة به، وسيرد عليك هناك بتقييم أولي وموعد للمعاينة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每位经纪人都会在单独的聊天中收到你的房产信息，并在那里回复你初步评估和看房时间。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada uno de ellos tiene tu propiedad en su propio chat y te responderá allí con una primera valoración y una fecha para la visita."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki od njih ima tvoju nekretninu u vlastitom chatu i tamo će ti odgovoriti s prvom procjenom i terminom za razgledavanje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого из них твоя недвижимость в отдельном чате, и там они ответят тебе с первой оценкой и датой просмотра."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her biri mülkünü kendi sohbetinde aldı ve sana orada ilk değerlendirme ve bir görüş tarihiyle yanıt verecek."
          }
        }
      }
    },
    "Each of them has your wishes in a chat of their own and will send you the right properties from their portfolio there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder von ihnen hat deine Wünsche in einem eigenen Chat und schickt dir dort die passenden Immobilien aus seinem Portfolio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacun d'eux a tes souhaits dans sa propre conversation et t'y enverra les biens qui conviennent dans son portefeuille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ognuno di loro ha i tuoi desideri in una chat dedicata e lì ti invierà gli immobili giusti dal suo portafoglio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لدى كل واحد منهم رغباتك في محادثة خاصة به، وسيرسل لك هناك العقارات المناسبة من محفظته."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每位经纪人都会在单独的聊天中收到你的需求，并在那里为你推荐他们房源中合适的房产。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada uno de ellos tiene tus deseos en su propio chat y te enviará allí las propiedades adecuadas de su cartera."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki od njih ima tvoje želje u vlastitom chatu i tamo će ti poslati prave nekretnine iz svog portfelja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого из них твои пожелания в отдельном чате, и там он пришлёт тебе подходящие объекты из своего портфеля."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her biri isteklerini kendi sohbetinde aldı ve sana orada portföyünden uygun mülkleri gönderecek."
          }
        }
      }
    },
