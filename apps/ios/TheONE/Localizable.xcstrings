    "Eight lessons with POWER AI, personal to you, each with one task for your week.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Lektionen mit POWER AI, ganz auf dich abgestimmt, jede mit einer Aufgabe für deine Woche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit leçons avec POWER AI, adaptées à toi, chacune avec une tâche pour ta semaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Otto lezioni con POWER AI, su misura per te, ognuna con un compito per la tua settimana."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثمانية دروس مع POWER AI، مصممة لك، وفي كل درس مهمة لأسبوعك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 POWER AI 一起的八节课，为你量身定制，每节课都有一项本周任务。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho lecciones con POWER AI, hechas para ti, cada una con una tarea para tu semana."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Osam lekcija s POWER AI, prilagođenih tebi, svaka sa zadatkom za tvoj tjedan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
