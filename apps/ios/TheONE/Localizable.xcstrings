    "Your photo is only used for the analysis and is not stored by TheONE. Only the results are kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Foto wird nur für die Analyse verwendet und von TheONE nicht gespeichert. Nur die Ergebnisse bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta photo sert uniquement à l'analyse et n'est pas conservée par TheONE. Seuls les résultats sont gardés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua foto viene usata solo per l'analisi e TheONE non la conserva. Vengono salvati solo i risultati."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم صورتك للتحليل فقط، ولا تُخزَّن لدى TheONE. ولا يُحتفظ إلا بالنتائج."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的照片仅用于分析，TheONE 不会保存。只保留分析结果。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu foto solo se usa para el análisis y TheONE no la guarda. Solo se conservan los resultados."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja fotografija koristi se samo za analizu i TheONE je ne pohranjuje. Čuvaju se samo rezultati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоё фото используется только для анализа, TheONE его не хранит. Сохраняются только результаты."
          }
