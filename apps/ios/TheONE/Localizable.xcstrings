    "%@ would like to meet you too. Write a few personal lines.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ möchte dich auch kennenlernen. Schreib ein paar persönliche Zeilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aimerait aussi te rencontrer. Écris-lui quelques mots personnels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche %@ desidera conoscerti. Scrivi qualche riga personale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لدى %@ أيضاً رغبة في لقائك. يمكنك كتابة بضعة أسطر شخصية."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@也想认识你。写几句真诚的话吧。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ también quiere conocerte. Escríbele unas líneas personales."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te također želi upoznati. Napiši nekoliko osobnih riječi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ тоже хочет с тобой познакомиться. Напиши несколько личных строк."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seninle tanışmak istiyor, tıpkı senin gibi. Ona birkaç kişisel satır yaz."
          }
        }
      }
    },
