    "And some lovely news: you have %lld matches.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und noch eine schöne Nachricht: Du hast %lld MATCHES."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et une très belle surprise : tu as %lld matchs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "E una bella notizia: hai %lld match."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وإليك خبر جميل: لديك %lld من التوافقات."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有个好消息：你有%lld个配对。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y una noticia preciosa: tienes %lld matches."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "I još jedna lijepa vijest: broj tvojih MATCH poznanstava: %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И приятная весть: у тебя совпадений: %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir de güzel bir haber: %lld eşleşmen var."
          }
        }
      }
    },
    "And some lovely news: you have a match with %@.": {
      "extractionState": "manual",
