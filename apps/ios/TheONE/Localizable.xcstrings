    "How connected do you feel to the people close to you?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie verbunden fühlst du dich mit den Menschen, die dir nahestehen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel point te sens-tu proche des personnes qui comptent pour toi ?"
