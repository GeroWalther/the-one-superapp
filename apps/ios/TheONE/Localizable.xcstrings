    "Hand-picked for you: only the best two or three in each area, with exactly what they offer.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dich ausgewählt: nur die besten zwei oder drei in jedem Bereich, mit genau dem, was sie anbieten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisi pour toi : seulement les deux ou trois meilleurs de chaque domaine, avec exactement ce qu'ils proposent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scelto per te: solo i migliori due o tre in ogni ambito, con esattamente ciò che offrono."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مختار لك: أفضل اثنين أو ثلاثة فقط في كل مجال، مع ما يقدّمونه بالتحديد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你精选：每个领域只选最好的两到三家，并列出他们提供的具体内容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegido para ti: solo los dos o tres mejores de cada ámbito, con exactamente lo que ofrecen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabrano za tebe: samo najbolja dva ili tri u svakom području, s točno onim što nude."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрано для тебя: только два или три лучших в каждой сфере, и именно то, что они предлагают."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senin için seçildi: her alanda yalnızca en iyi iki ya da üç ortak ve tam olarak sundukları."
          }
        }
      }
    },
