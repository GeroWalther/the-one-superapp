<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only standard HTTPS, so no export-compliance paperwork per upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>TheONE uses the camera for your skin analysis. The photo is only used for the analysis and is not stored by TheONE.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>TheONE uses the microphone so you can speak to your concierge instead of typing.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Speech is recognised on your device so you can talk to your concierge. Audio is not sent to Apple when on-device recognition is available.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Allows the simulator to reach the local development server.
		     Production traffic still requires HTTPS. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Plain start-screen colour, no image: the app opens straight on the
	     start screen, whose top is this colour, so launch hands over without a jump. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
