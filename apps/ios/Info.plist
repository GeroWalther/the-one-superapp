<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only standard HTTPS, so no export-compliance paperwork per upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>TheONE uses the microphone so you can speak to your concierge instead of typing.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Speech is recognised on your device so you can talk to your concierge. Audio is not sent to Apple when on-device recognition is available.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Allows the simulator to reach the local development server.
		     Production traffic still requires HTTPS. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The mark on white. RootView's loading state draws the same mark at the
	     same size, so launch hands over to the app without a visible jump. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
</dict>
</plist>
